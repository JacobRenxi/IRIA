# ===== ALL tokens for the hub live in this file =====

# --- Web chat (src/web.py) ---
WEB_USER=admin
WEB_PASSWORD=change-me-to-12-plus-chars   # required, 12+ characters
WEB_PORT=8090
# WEB_HOST=0.0.0.0
# Serve HTTPS (recommended: Basic auth over plain HTTP can be read on the network)
# WEB_TLS_CERT=/path/to/hub.crt
# WEB_TLS_KEY=/path/to/hub.key

# --- Ollama (OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:11434/v1/
LLM_MODEL=your-model-tag            # from `ollama list`; must show "tools" under Capabilities in `ollama show`
# LLM_API_KEY=ollama                # Ollama ignores it; set only if a proxy in front of Ollama checks keys
# LLM_CA_BUNDLE=/path/to/internal-ca.pem

# --- Built-in Elasticsearch tools (leave ELASTIC_URL unset to disable) ---
ELASTIC_URL=https://your-elastic-host:9200
ELASTIC_API_KEY=your-encoded-api-key
# ELASTIC_CA_CERTS=/path/to/http_ca.crt

# --- MCP server tokens (referenced from hub.yaml as ${NAME}) ---
# MYSERVER_TOKEN=
# LEGACY_TOKEN=
# LOCALTOOL_TOKEN=
