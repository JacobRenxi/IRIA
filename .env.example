# ===== All settings and tokens for the hub live in this file =====
# Copy it to .env and fill it in. .env is never committed.

# --- Web app (src/app.py) ---
WEB_USER=admin
WEB_PASSWORD=change-me-to-12-plus-chars   # required, 12+ characters
WEB_PORT=8090
# WEB_HOST=0.0.0.0                  # default 127.0.0.1 (this computer only); 0.0.0.0 = reachable from your network
# Serve HTTPS (do this if WEB_HOST is not 127.0.0.1: over plain HTTP the password can be read on the network)
# WEB_TLS_CERT=/path/to/hub.crt
# WEB_TLS_KEY=/path/to/hub.key
# HUB_NAME=IRIA                     # the assistant's name in the UI and its default personality

# --- Model: Ollama (or any OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:11434/v1/
LLM_MODEL=qwen3:8b                  # from `ollama list`; needs "tools" under Capabilities in `ollama show <model>`
# LLM_API_KEY=ollama                # Ollama ignores it; set it for OpenRouter, a proxy, etc.
# LLM_CA_BUNDLE=/path/to/internal-ca.pem
# AGENT_MAX_STEPS=10                # tool rounds per answer

# --- Built-in Elasticsearch tools (off unless both are set) ---
# ELASTIC_URL=https://your-elastic-host:9200
# ELASTIC_API_KEY=your-encoded-api-key
# ELASTIC_CA_CERTS=/path/to/http_ca.crt

# --- MCP server tokens (referenced from hub.yaml as ${NAME}) ---
# MYSERVER_TOKEN=
# LEGACY_TOKEN=
# LOCALTOOL_TOKEN=
